@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5" style="max-width: 500px;">
    <div class="alert alert-success text-center">
        <h5>✅ Готово!</h5>
        <p>Якщо такий email існує в системі — посилання надіслано.</p>

        @* Для демо — показуємо посилання прямо на сторінці *@
        @if (TempData["ResetLink"] != null)
        {
                <hr />
                <p class="text-muted small">
                    <strong>Демо-режим:</strong> посилання для скидання:
                </p>
                <a href="@TempData["ResetLink"]" class="btn btn-sm btn-outline-primary">
                    Перейти до скидання пароля
                </a>
        }
    </div>
    <div class="text-center">
        <a asp-action="Login">← Повернутись до входу</a>
    </div>
</div>