@model PasswordGeneratorMvc.ViewModels.EditUserRolesViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">🛡️ Ролі користувача: @Model.Email</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="EditRoles" method="post">
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="FullName" />

                @for (int i = 0; i < Model.Roles.Count; i++)
                {
                        <div class="form-check mb-2">
                            <input type="hidden"
                                   name="Roles[@i].RoleName"
                                   value="@Model.Roles[i].RoleName" />
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="Roles[@i].IsSelected"
                                   value="true"
                                   id="role_@i"
                        @(Model.Roles[i].IsSelected ? "checked" : "") />
                            <label class="form-check-label" for="role_@i">
                            @Model.Roles[i].RoleName
                            </label>
                        </div>
                }

                <button type="submit" class="btn btn-primary w-100 mt-3">
                    Зберегти ролі
                </button>
            </form>

            <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">
                ← Назад
            </a>
        </div>
    </div>
</div>